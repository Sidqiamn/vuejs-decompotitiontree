{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["vue", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["__d", "__n"] }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }]
  },
  "ignorePatterns": ["dist/**"]
}
